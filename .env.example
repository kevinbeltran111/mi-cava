VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable

# Esta clave NO lleva el prefijo VITE_ a propósito: así el navegador nunca la
# ve, solo la usa la función del servidor (api/upload-photo.js). Sacala de
# Supabase > Project Settings > API Keys > "service_role" (o "secret").
# NUNCA la compartas ni la pongas en una variable con prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-o-secret

# Clave de la API de Anthropic (Claude), para identificar vinos por foto de
# etiqueta. Tampoco lleva prefijo VITE_ — solo la usa api/identify-wine.js.
# Se genera en https://console.anthropic.com (API Keys > Create Key).
ANTHROPIC_API_KEY=tu-clave-de-anthropic
